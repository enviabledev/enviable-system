# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://user:pass@localhost:5433/enviable?schema=public"

# Required. The app hard-fails at startup if this is unset.
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional. Defaults to 3000.
# PORT=3000

# Session store. Unset (or anything other than "redis") uses the in-memory store
# for local dev. Set to "redis" in production to use the Redis-backed store
# (connect-redis over ioredis), the Upstash target.
# SESSION_STORE=redis
# REDIS_URL="redis://localhost:6379"   # Upstash rediss://... URL in production
