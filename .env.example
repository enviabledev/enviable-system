# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://user:pass@localhost:5433/enviable?schema=public"

# Required. The app hard-fails at startup if this is unset.
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional. Defaults to 3000.
# PORT=3000

# Session store. Unset (or anything other than "redis") uses the in-memory store
# for local dev. Set to "redis" in production to use the Redis-backed store
# (connect-redis over ioredis), the Upstash target.
# SESSION_STORE=redis
# REDIS_URL="redis://localhost:6379"   # Upstash rediss://... URL in production

# ── Invoice / proforma PDF rendering (Prompt 28) ────────────────────────────
# Headless Chrome/Chromium used to render invoice PDFs. If unset, the renderer
# probes common install locations (macOS Google Chrome, Linux chromium). Set
# this in production (e.g. the container's chromium) for a stable binary.
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"
#
# Company identity printed on the documents. All optional; each falls back to the
# real registered values baked into company-profile.ts, so a fresh environment
# renders correct documents without any of these set. There is no company-profile
# table yet (see BACKLOG); these live in config. The values below are the live
# production values (Theresa, prompt 51) and should be set in production SSM.
# INVOICE_COMPANY_NAME="Enviable Tricycle Auto Parts Limited"
# INVOICE_COMPANY_ADDRESS="52 Saka Tinubu Street, VI Lagos"  # pipe (|) separates lines
# INVOICE_COMPANY_TEL=""  # no company phone supplied yet; the Tel line is omitted when blank
# INVOICE_COMPANY_EMAIL="info@enviabletricycle.com"
# INVOICE_COMPANY_RC="6987445"
# INVOICE_COMPANY_TIN="31405903-0001"
#
# Bank accounts the customer pays into, routed by the sales order's wheeler type
# (one account per type). Sort code is optional: blank omits the sort line (NIP
# transfers route on bank + account number alone). Both accounts are at Globus.
# INVOICE_BANK_3W_NAME="Globus Bank"
# INVOICE_BANK_3W_ACCOUNT_NAME="Enviable Tricycle Auto Parts Limited Account 2"
# INVOICE_BANK_3W_ACCOUNT_NUMBER="1000503348"
# INVOICE_BANK_3W_SORT_CODE=""
# INVOICE_BANK_2W_NAME="Globus Bank"
# INVOICE_BANK_2W_ACCOUNT_NAME="Enviable Tricycles Auto Parts Ltd - 2 Wheeler"
# INVOICE_BANK_2W_ACCOUNT_NUMBER="1000579033"
# INVOICE_BANK_2W_SORT_CODE=""
#
# Sales invoices have no currency column yet (sales are Naira); overridable.
# INVOICE_SALES_CURRENCY="NGN"
# Default payment term (days) used to derive the sales invoice due date and the
# "Net N Days" label, until per-order terms are captured (see BACKLOG).
# INVOICE_DEFAULT_NET_DAYS="14"
#
# Customer warranty term in months. Wired into ReturnsService but not yet
# consumed: the warranty-validity hook (prompt 40) stays a no-op until the
# supplier warranty term is confirmed. Default 12.
# CUSTOMER_WARRANTY_MONTHS="12"

# ── User/role management (Prompt 30) ────────────────────────────────────────
# REQUIRED to create users. The user-creation endpoint hard-fails if this is
# unset (no hardcoded fallback; ops must configure it intentionally). The value
# is the initial password every newly-created user receives; they are forced to
# change it on first login (mustResetPassword gate), so it is NEVER a usable
# credential beyond the reset screen. Choose something:
#   - easy to communicate verbally between admin and new user
#   - strong enough for the brief window before first login
# Set this per-environment; never reuse a real persisted credential.
DEFAULT_INITIAL_PASSWORD="ChangeMe123!"
